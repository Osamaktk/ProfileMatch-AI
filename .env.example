# Phase 1 search provider (required)
SERPER_API_KEY=

# Phase 2 AI verification: configure at least one provider.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_MODEL_FALLBACKS=llama-3.3-70b-versatile,openai/gpt-oss-20b,llama-3.1-8b-instant

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_FALLBACKS=deepseek-v4-pro

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MODEL_FALLBACKS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-nano-9b-v2:free,openai/gpt-oss-20b:free

# Runtime controls
CONTACT_ENRICHMENT_ENABLED=true
DAILY_REQUEST_LIMIT=50
LLM_THROTTLE_SECONDS=4
SERPER_TIMEOUT_SECONDS=15
SERPER_RETRIES=2
SERPER_RESULTS=3
SECUREDESK_LOG_LEVEL=INFO
